{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/bootcamp", "destination": "/" },
    { "source": "/register", "destination": "/" },
    { "source": "/admin", "destination": "/" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
